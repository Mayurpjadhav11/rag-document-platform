# Copy to .env and edit. All values are optional.
PORT=5000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Set to an embedding model (e.g. nomic-embed-text) to enable hybrid BM25 + vector retrieval.
OLLAMA_EMBED_MODEL=
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MAX_UPLOAD_MB=50
CORS_ORIGINS=*
